{
  "type": "HZA",
  "n": 3,
  "Q": ["s", "q", "f"],
  "Sigma": ["a", "b", "c", "d", "e", "f"],
  "Gamma": ["S", "A", "B", "C", "#"],
  "s": "s",
  "S": "S",
  "F": ["f"],
  "rules": [
    {
