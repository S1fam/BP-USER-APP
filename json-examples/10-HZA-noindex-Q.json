      "from": "s",
      "depth": 1,
      "expand-from": ["S"],
      "expand-to": ["ABC"],
      "to": "q"
    },
    {
      "comment": "2: 1qA -> q aAb  (generuj dalsi par a..b)",
      "from": "q",
      "depth": 1,
      "expand-from": ["A"],
      "expand-to": ["aAb"],
      "to": "q"
    },
    {
      "comment": "3: 1qA -> f ab  (posledni iterace)",
      "from": "q",
      "depth": 1,
      "expand-from": ["A"],
      "expand-to": ["ab"],
      "to": "f"
    },
    {
      "comment": "4: 2qB -> q cBd  (generuj dalsi par c..d)",
      "from": "q",
      "depth": 2,
      "expand-from": ["B"],
      "expand-to": ["cBd"],
      "to": "q"
    },
    {
      "comment": "5: 3qC -> q eCf  (generuj dalsi par e..f)",
      "from": "q",
      "depth": 3,
      "expand-from": ["C"],
      "expand-to": ["eCf"],
      "to": "q"
    },
    {
      "comment": "6: 1fB -> f cd",
      "from": "f",
      "depth": 1,
      "expand-from": ["B"],
      "expand-to": ["cd"],
      "to": "f"
    },
    {
      "comment": "7: 1fC -> f ef",
      "from": "f",
      "depth": 1,
      "expand-from": ["C"],
      "expand-to": ["ef"],
      "to": "f"
    }
  ]
