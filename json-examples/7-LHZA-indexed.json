{
  "type": "LHZA",
  "n": 3,
  "Q": ["s", "q1", "q2", "q3", "qf"],
  "Sigma": ["a", "b", "c", "d", "e", "f"],
  "Gamma": ["S", "A", "B", "C", "#"],
  "s": "s",
  "S": "S",
  "F": ["qf"],
  "rules": [
    {
      "comment": "1: 1sS -> q1 ABC",
      "from": "s",
      "depth": 1,
      "expand-from": ["S"],
      "expand-to": ["ABC"],
      "to": "q1"
    },
    {
      "comment": "2: 1q1A 2=a -> q2 aAb  (pokracujeme v generovani)",
      "from": "q1",
      "depth": 1,
      "expand-from": ["A"],
      "expand-to": ["aAb"],
      "to": "q2",
      "input-depth": 2,
      "lookahead": "a"
    },
    {
      "comment": "3: 1q1A 2=b -> qf ab  (posledni iterace)",
      "from": "q1",
      "depth": 1,
      "expand-from": ["A"],
      "expand-to": ["ab"],
      "to": "qf",
      "input-depth": 2,
      "lookahead": "b"
    },
    {
      "comment": "4: 2q2B -> q3 cBd",
      "from": "q2",
      "depth": 2,
      "expand-from": ["B"],
      "expand-to": ["cBd"],
      "to": "q3"
    },
    {
      "comment": "5: 3q3C -> q1 eCf",
      "from": "q3",
      "depth": 3,
      "expand-from": ["C"],
      "expand-to": ["eCf"],
      "to": "q1"
    },
    {
      "comment": "6: 1qfB -> qf cd",
      "from": "qf",
      "depth": 1,
      "expand-from": ["B"],
      "expand-to": ["cd"],
      "to": "qf"
    },
    {
      "comment": "7: 1qfC -> qf ef",
      "from": "qf",
      "depth": 1,
      "expand-from": ["C"],
      "expand-to": ["ef"],
      "to": "qf"
    }
  ]
}
